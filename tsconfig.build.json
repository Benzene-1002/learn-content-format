{
  // 配布物のビルド用。テストと型検査は tsconfig.json が見る。
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    // 配るのは dist と fixtures だけ(package.json の files)。src を配らない以上、
    // 行き先の無い .map は置かない。
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
